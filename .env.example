# reCAPTCHA v3 (formulaires contact / partenaires)
# Cle de site (publique, injectee dans le HTML)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Cle secrete (serveur uniquement, ne jamais exposer au navigateur)
RECAPTCHA_SECRET_KEY=

# Webhook Make.com pour les soumissions de formulaire
# Obligatoire : sans cette variable, les formulaires renvoient une erreur.
CONTACT_WEBHOOK_URL=

# Destinataire affiche dans le payload envoye a Make
CONTACT_TO_EMAIL=contact@drivelady.fr

# Google Tag Manager - si vide, GTM n'est pas charge.
# Le conteneur n'est injecte qu'apres acceptation dans le bandeau cookies.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 en direct (ex: G-XXXXXXXXXX) - si vide, GA n'est pas charge.
# A laisser VIDE si le conteneur GTM contient deja une balise GA4, sinon les
# pages vues seront comptees deux fois.
NEXT_PUBLIC_GA_ID=
